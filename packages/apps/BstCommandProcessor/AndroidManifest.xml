<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bluestacks.BstCommandProcessor"
    android:versionCode="10101" android:versionName="101.01"
    coreApp="true"
    android:sharedUserId="android.uid.system">
    <uses-sdk android:minSdkVersion="25" />

    <protected-broadcast android:name="com.bluestacks.action.START_APP" />
    <protected-broadcast android:name="com.bluestacks.action.INSTALL_APK_RESPONSE" />
    <protected-broadcast android:name="com.bluestacks.action.SHOW_INSTALL_VIEW" />
    <protected-broadcast android:name="com.bluestacks.action.ENABLE_ANDROID_ADS" />
    <protected-broadcast android:name="com.bluestacks.action.GAMEPAD_STATE" />
    <protected-broadcast android:name="com.bluestacks.home.AFFILIATE_HANDLER_HTML" />
    <protected-broadcast android:name="com.bluestacks.action.INTERSTITIAL_AD_SETTING" />
    <protected-broadcast android:name="com.bluestacks.action.LAUNCHER_APP_SHOW_HIDE" />
    <protected-broadcast android:name="com.bluestacks.action.GAME_CENTER_APP_SHOW_HIDE"/>
    <protected-broadcast android:name="com.bluestacks.action.GAME_CENTER_INSTALL_APP"/>
    <!-- Faking this permission -->
    <permission android:name="android.permission.ACCESS_BLUETOOTH_SHARE"
        android:label="@string/permlab_bluetoothShareManager"
        android:description="@string/permdesc_bluetoothShareManager"
        android:protectionLevel="signature" />

    <!--  Faking this permission -->
    <permission android:name="com.android.permission.WHITELIST_BLUETOOTH_DEVICE"
        android:label="@string/permlab_bluetoothWhitelist"
        android:description="@string/permdesc_bluetoothWhitelist"
        android:protectionLevel="signature" />

    <application android:name="BstCommandProcessorApplication"
        android:persistent="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <service android:exported="true"
            android:name=".BstCommandProcessorService">
            <intent-filter>
                <action
                    android:name="com.bluestacks.BstCommandProcessorService">
                </action>
            </intent-filter>
        </service>
     <service
            android:name=".UiAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
                <intent-filter>
                    <action android:name="android.accessibilityservice.AccessibilityService" />
                </intent-filter>
                <meta-data
                    android:name="android.accessibilityservice"
                    android:resource="@xml/accessibility_service_config" />
     </service>
     <service android:name=".BstCommandProcessorIntentService"
            android:enabled="true"
            android:exported="true" />

    </application>
    <uses-permission android:name="android.permission.INTERNET"></uses-permission>
    <uses-permission android:name="android.permission.GET_ACCOUNTS"></uses-permission>
    <uses-permission android:name="android.permission.GET_TASKS"></uses-permission>
    <uses-permission android:name="android.permission.SET_TIME"></uses-permission>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"></uses-permission>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"></uses-permission>
    <uses-permission android:name="android.permission.RESTART_PACKAGES"></uses-permission>
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES"></uses-permission>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"></uses-permission>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"></uses-permission>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"></uses-permission>
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"></uses-permission>
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS"></uses-permission>
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS"></uses-permission>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"></uses-permission>
</manifest>
