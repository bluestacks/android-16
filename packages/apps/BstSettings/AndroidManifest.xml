<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bluestacks.settings"
    android:versionCode="69"
    android:versionName="69.1" >

    <uses-sdk android:minSdkVersion="25"
            android:targetSdkVersion="25"/>

    <queries>
        <package android:name="com.andorid.settings" />
        <package android:name="com.android.permissioncontroller" />
    </queries>

    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />

    <application
        android:icon="@mipmap/ic_launcher_settings"
        android:label="@string/app_name"
        android:supportsRtl="true"
    	android:theme="@style/AppTheme">
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:clearTaskOnLaunch="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InputMethodSettings"
            android:label="@string/input_method_settings"
            android:icon="@drawable/ic_settings_select_ime"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EnableIME"
            android:theme="@style/ActionBarStyle"
            >
        </activity>
    </application>
</manifest>
